# Override split ratio
TRAIN_RATIO = 0.85
VAL_RATIO   = 0.07

n     = len(X_seq)
t_end = int(n * TRAIN_RATIO)
v_end = int(n * (TRAIN_RATIO + VAL_RATIO))

X_train, y_train = X_seq[:t_end],      y_seq[:t_end]
X_val,   y_val   = X_seq[t_end:v_end], y_seq[t_end:v_end]
X_test,  y_test  = X_seq[v_end:],      y_seq[v_end:]

print(f"Train: {X_train.shape} | ${scaler.inverse_transform(y_train.reshape(-1,1)).min():.2f} - ${scaler.inverse_transform(y_train.reshape(-1,1)).max():.2f}")
print(f"Val  : {X_val.shape}")
print(f"Test : {X_test.shape} | ${scaler.inverse_transform(y_test.reshape(-1,1)).min():.2f} - ${scaler.inverse_transform(y_test.reshape(-1,1)).max():.2f}")

X_tr = torch.FloatTensor(X_train)
y_tr = torch.FloatTensor(y_train).unsqueeze(1)
X_v  = torch.FloatTensor(X_val)
y_v  = torch.FloatTensor(y_val).unsqueeze(1)
X_te = torch.FloatTensor(X_test)

train_loader = DataLoader(TensorDataset(X_tr, y_tr), batch_size=BATCH_SIZE, shuffle=False)
val_loader   = DataLoader(TensorDataset(X_v, y_v),   batch_size=BATCH_SIZE, shuffle=False)

# Reinitialize model with fixed seed
random.seed(42)
np.random.seed(42)
torch.manual_seed(42)
torch.cuda.manual_seed(42)

model = GCNLSTMwithRSI(2, GCN_HIDDEN, GCN_OUT, LSTM_UNITS,
                       ATTN_HEADS, DROPOUT, n_stocks, stock_idx).to(device)

optimizer    = torch.optim.RMSprop(model.parameters(), lr=LEARNING_RATE)
criterion    = nn.MSELoss()
train_losses = []
val_losses   = []
best_val     = float('inf')
patience_cnt = 0
best_weights = None

for epoch in range(1, EPOCHS+1):
    model.train()
    tl = 0
    for Xb, yb in train_loader:
        Xb, yb = Xb.to(device), yb.to(device)
        optimizer.zero_grad()
        loss = criterion(model(Xb, adj_norm), yb)
        loss.backward()
        optimizer.step()
        tl += loss.item()
    tl /= len(train_loader)

    model.eval()
    vl = 0
    with torch.no_grad():
        for Xb, yb in val_loader:
            Xb, yb = Xb.to(device), yb.to(device)
            vl += criterion(model(Xb, adj_norm), yb).item()
    vl /= len(val_loader)

    train_losses.append(tl)
    val_losses.append(vl)
    print(f"  Epoch {epoch:2d}/{EPOCHS} | Train: {tl:.6f} | Val: {vl:.6f}")

    if vl < best_val:
        best_val     = vl
        best_weights = {k: v.clone() for k,v in model.state_dict().items()}
        patience_cnt = 0
    else:
        patience_cnt += 1
        if patience_cnt >= PATIENCE:
            print(f"\n  Early stopping at epoch {epoch}")
            break

model.load_state_dict(best_weights)
print(f"\n  Best val loss: {best_val:.6f}")

# Evaluate
model.eval()
preds = []
with torch.no_grad():
    for i in range(0, len(X_te), BATCH_SIZE):
        out = model(X_te[i:i+BATCH_SIZE].to(device), adj_norm)
        preds.extend(out.cpu().numpy().flatten())

preds   = np.array(preds)
actuals = y_test

pred_usd   = scaler.inverse_transform(preds.reshape(-1,1)).flatten()
actual_usd = scaler.inverse_transform(actuals.reshape(-1,1)).flatten()

mse  = mean_squared_error(actual_usd, pred_usd)
rmse = np.sqrt(mse)
mae  = mean_absolute_error(actual_usd, pred_usd)
r2   = r2_score(actual_usd, pred_usd)

print(f"\n  MSE  : {mse:.4f}")
print(f"  RMSE : {rmse:.4f}")
print(f"  MAE  : {mae:.4f}")
print(f"  R2   : {r2:.4f}")

# Plot
plt.figure(figsize=(14, 5))
plt.plot(actual_usd, label='Actual',    color='#2196F3', linewidth=1.5)
plt.plot(pred_usd,   label='Predicted', color='#FF5722', linewidth=1.5, alpha=0.8)
plt.title(f'XOM - Actual vs Predicted Price (GCN-LSTM+RSI) | R2={r2:.4f}')
plt.xlabel('Test Days')
plt.ylabel('Price (USD)')
plt.legend()
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig(BASE_PATH + 'prediction_vs_actual_85split.png', dpi=150)
plt.show()
