# =============================================================================
# COMPLETE GCN-LSTM+RSI PIPELINE WITH PYTORCH GEOMETRIC
# Base paper: Amiri et al. 2025 + RSI extension
# Target: XOM (Exxon Mobil) - same as base paper
# =============================================================================

import numpy as np
import pandas as pd
import pickle
import random
import os
import torch
import torch.nn as nn
from torch.utils.data import DataLoader, TensorDataset
import matplotlib.pyplot as plt
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
from dtaidistance import dtw

# Fix random seed
random.seed(42)
np.random.seed(42)
torch.manual_seed(42)
torch.cuda.manual_seed(42)
torch.backends.cudnn.deterministic = True
torch.backends.cudnn.benchmark = False

# ── CONFIGURATION ─────────────────────────────────────────────────────────────
BASE_PATH     = '/content/drive/MyDrive/Stock_Prediction/'
DATA_DIR      = BASE_PATH + 'data/raw_us/'
START_DATE    = '2011-03-01'
END_DATE      = '2024-09-26'
RSI_PERIOD    = 14
LOOKBACK      = 30
DTW_THRESHOLD = 0.7
GCN_HIDDEN    = 32
GCN_OUT       = 64
LSTM_UNITS    = 64
ATTN_HEADS    = 4
DROPOUT       = 0.3
BATCH_SIZE    = 64
LEARNING_RATE = 0.0002
EPOCHS        = 20
PATIENCE      = 10
TRAIN_RATIO   = 0.70
VAL_RATIO     = 0.20
TARGET_STOCK  = 'XOM'

STOCKS = [
    'XOM', 'CVX', 'COP', 'SHEL', 'TTE',
    'SLB', 'HAL', 'BKR',
    'EOG', 'DVN', 'CNQ', 'SU',
    'ENB', 'EPD', 'WMB', 'OKE', 'LNG',
    'VLO', 'MPC', 'BP',
    'EC', 'E', 'IMO', 'TRP'
]

print("=" * 60)
print("  GCN-LSTM+RSI PIPELINE (PyTorch Geometric)")
print("=" * 60)

# =============================================================================
# MODULE 1: LOAD DATA
# =============================================================================
print("\n[Module 1] Loading stock data...")

def load_stock(filepath):
    df = pd.read_csv(filepath, skiprows=3, header=None,
                     names=['Date','Close','High','Low','Open','Volume'])
    df['Date'] = pd.to_datetime(df['Date'], errors='coerce')
    df = df.dropna(subset=['Date'])
    df.set_index('Date', inplace=True)
    df = df[['Open']].astype(float)
    df = df.sort_index()
    return df

all_data = {}
missing = []
for stock in STOCKS:
    filepath = DATA_DIR + stock + '.csv'
    if not os.path.exists(filepath):
        missing.append(stock)
        continue
    df = load_stock(filepath)
    all_data[stock] = df
    print(f"  {stock}: {len(df)} rows")

print(f"\n  Loaded: {len(all_data)} stocks | Missing: {missing}")

# =============================================================================
# MODULE 2: PREPROCESSING + RSI
# =============================================================================
print("\n[Module 2] Preprocessing + RSI...")

# Align to common date range
combined = pd.concat(
    [df.rename(columns={'Open': name}) for name, df in all_data.items()],
    axis=1, join='inner'
)
combined = combined.ffill().bfill()
print(f"  Common range: {combined.index[0].date()} to {combined.index[-1].date()}")
print(f"  Trading days: {len(combined)}")

# Compute RSI
def compute_rsi(series, period=14):
    delta    = series.diff()
    gain     = delta.clip(lower=0)
    loss     = -delta.clip(upper=0)
    avg_gain = gain.ewm(com=period-1, min_periods=period).mean()
    avg_loss = loss.ewm(com=period-1, min_periods=period).mean()
    rs       = avg_gain / (avg_loss + 1e-10)
    return 100 - (100 / (1 + rs))

# Build features and scalers
features      = {}
price_scalers = {}

for stock in combined.columns:
    price  = combined[stock].values
    rsi    = compute_rsi(combined[stock]).values

    df_tmp = pd.DataFrame({'price': price, 'rsi': rsi}).dropna()
    df_tmp = df_tmp.iloc[RSI_PERIOD:]

    p_scaler = MinMaxScaler()
    r_scaler = MinMaxScaler()

    p_norm = p_scaler.fit_transform(df_tmp[['price']]).flatten()
    r_norm = r_scaler.fit_transform(df_tmp[['rsi']]).flatten()

    features[stock]      = np.column_stack([p_norm, r_norm])
    price_scalers[stock] = p_scaler

T = features[STOCKS[0]].shape[0]
print(f"  Samples per stock: {T}")
print(f"  RSI range for {TARGET_STOCK}: [{features[TARGET_STOCK][:,1].min():.1f}, {features[TARGET_STOCK][:,1].max():.1f}]")

# =============================================================================
# MODULE 3: DTW GRAPH CONSTRUCTION
# =============================================================================
print("\n[Module 3] Building DTW graph...")

stocks    = list(features.keys())
n_stocks  = len(stocks)
stock_idx = stocks.index(TARGET_STOCK)

# DTW distance matrix
dtw_matrix = np.zeros((n_stocks, n_stocks))
total      = (n_stocks * (n_stocks-1)) // 2
computed   = 0

for i in range(n_stocks):
    for j in range(i+1, n_stocks):
        s1 = features[stocks[i]][:, 0].astype(np.double)
        s2 = features[stocks[j]][:, 0].astype(np.double)
        d  = dtw.distance_fast(s1, s2)
        dtw_matrix[i][j] = d
        dtw_matrix[j][i] = d
        computed += 1
        if computed % 50 == 0:
            print(f"  DTW progress: {computed}/{total}")

np.fill_diagonal(dtw_matrix, 0)

# Convert to correlation
max_d   = dtw_matrix[dtw_matrix > 0].max()
min_d   = dtw_matrix[dtw_matrix > 0].min()
corr    = np.zeros((n_stocks, n_stocks))
for i in range(n_stocks):
    for j in range(n_stocks):
        if i == j:
            corr[i][j] = 1.0
        else:
            corr[i][j] = 1 - (dtw_matrix[i][j] - min_d) / (max_d - min_d)

# Build adjacency matrix with Gaussian kernel
adj = np.zeros((n_stocks, n_stocks))
for i in range(n_stocks):
    for j in range(n_stocks):
        if i != j and corr[i][j] >= DTW_THRESHOLD:
            d          = 1 - corr[i][j]
            adj[i][j]  = np.exp(-(d**2))

print(f"  Edges formed: {(adj > 0).sum()}")
print(f"  Graph density: {(adj > 0).sum() / (n_stocks*(n_stocks-1)):.2%}")

# Normalize adjacency
def normalize_adj(a):
    t       = torch.FloatTensor(a)
    deg     = t.sum(dim=1)
    deg_inv = torch.pow(deg + 1e-10, -0.5)
    D       = torch.diag(deg_inv)
    return D @ t @ D

adj_norm = normalize_adj(adj)

# =============================================================================
# MODULE 4: BUILD SEQUENCES
# =============================================================================
print("\n[Module 4] Building sequences...")

X_all = np.zeros((T, n_stocks, 2))
for i, stock in enumerate(stocks):
    X_all[:, i, :] = features[stock]

target = features[TARGET_STOCK][:, 0]

X_seq, y_seq = [], []
for i in range(LOOKBACK, T):
    X_seq.append(X_all[i-LOOKBACK:i])
    y_seq.append(target[i])

X_seq = np.array(X_seq)
y_seq = np.array(y_seq)

print(f"  X: {X_seq.shape} | y: {y_seq.shape}")

# Split
n     = len(X_seq)
t_end = int(n * TRAIN_RATIO)
v_end = int(n * (TRAIN_RATIO + VAL_RATIO))

X_train, y_train = X_seq[:t_end],      y_seq[:t_end]
X_val,   y_val   = X_seq[t_end:v_end], y_seq[t_end:v_end]
X_test,  y_test  = X_seq[v_end:],      y_seq[v_end:]

scaler = price_scalers[TARGET_STOCK]
print(f"  Train: {X_train.shape} | price ${scaler.inverse_transform(y_train.reshape(-1,1)).min():.2f} - ${scaler.inverse_transform(y_train.reshape(-1,1)).max():.2f}")
print(f"  Val  : {X_val.shape}")
print(f"  Test : {X_test.shape} | price ${scaler.inverse_transform(y_test.reshape(-1,1)).min():.2f} - ${scaler.inverse_transform(y_test.reshape(-1,1)).max():.2f}")

X_tr = torch.FloatTensor(X_train)
y_tr = torch.FloatTensor(y_train).unsqueeze(1)
X_v  = torch.FloatTensor(X_val)
y_v  = torch.FloatTensor(y_val).unsqueeze(1)
X_te = torch.FloatTensor(X_test)

train_loader = DataLoader(TensorDataset(X_tr, y_tr), batch_size=BATCH_SIZE, shuffle=False)
val_loader   = DataLoader(TensorDataset(X_v,  y_v),  batch_size=BATCH_SIZE, shuffle=False)

# =============================================================================
# MODULE 5: GCN-LSTM MODEL
# =============================================================================
print("\n[Module 5] Building GCN-LSTM+RSI model...")

class GCNLayer(nn.Module):
    def __init__(self, in_f, out_f):
        super().__init__()
        self.linear  = nn.Linear(in_f, out_f)
        self.relu    = nn.ReLU()
        self.dropout = nn.Dropout(0.2)

    def forward(self, x, adj):
        return self.dropout(self.relu(self.linear(torch.matmul(adj, x))))

class AttentionLayer(nn.Module):
    def __init__(self, h, heads):
        super().__init__()
        self.attn = nn.MultiheadAttention(h, heads, dropout=DROPOUT, batch_first=True)
        self.norm = nn.LayerNorm(h)

    def forward(self, x):
        out, _ = self.attn(x, x, x)
        return self.norm(x + out)

class GCNLSTMwithRSI(nn.Module):
    def __init__(self, in_f, gcn_h, gcn_out, lstm_h, heads, drop, n_s, s_idx):
        super().__init__()
        self.s_idx = s_idx
        self.gcn1  = GCNLayer(in_f, gcn_h)
        self.gcn2  = GCNLayer(gcn_h, gcn_out)
        self.lstm  = nn.LSTM(gcn_out, lstm_h, num_layers=2,
                             batch_first=True, dropout=drop)
        self.attn  = AttentionLayer(lstm_h, heads)
        self.drop  = nn.Dropout(drop)
        self.fc    = nn.Linear(lstm_h, 1)

    def forward(self, x, adj):
        seq = []
        for t in range(x.shape[1]):
            h = self.gcn2(self.gcn1(x[:, t], adj), adj)
            seq.append(h[:, self.s_idx])
        seq    = torch.stack(seq, dim=1)
        out, _ = self.lstm(seq)
        out    = self.drop(out)
        out    = self.attn(out)
        return self.fc(out[:, -1])

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"  Device: {device}")

model    = GCNLSTMwithRSI(2, GCN_HIDDEN, GCN_OUT, LSTM_UNITS,
                           ATTN_HEADS, DROPOUT, n_stocks, stock_idx).to(device)
adj_norm = adj_norm.to(device)

print(f"  Parameters: {sum(p.numel() for p in model.parameters()):,}")

# =============================================================================
# MODULE 6: TRAINING
# =============================================================================
print("\n[Module 6] Training...")

optimizer    = torch.optim.RMSprop(model.parameters(), lr=LEARNING_RATE)
criterion    = nn.MSELoss()
train_losses = []
val_losses   = []
best_val     = float('inf')
patience_cnt = 0
best_weights = None

for epoch in range(1, EPOCHS+1):
    model.train()
    tl = 0
    for Xb, yb in train_loader:
        Xb, yb = Xb.to(device), yb.to(device)
        optimizer.zero_grad()
        loss = criterion(model(Xb, adj_norm), yb)
        loss.backward()
        optimizer.step()
        tl += loss.item()
    tl /= len(train_loader)

    model.eval()
    vl = 0
    with torch.no_grad():
        for Xb, yb in val_loader:
            Xb, yb = Xb.to(device), yb.to(device)
            vl += criterion(model(Xb, adj_norm), yb).item()
    vl /= len(val_loader)

    train_losses.append(tl)
    val_losses.append(vl)
    print(f"  Epoch {epoch:2d}/{EPOCHS} | Train: {tl:.6f} | Val: {vl:.6f}")

    if vl < best_val:
        best_val     = vl
        best_weights = {k: v.clone() for k,v in model.state_dict().items()}
        patience_cnt = 0
    else:
        patience_cnt += 1
        if patience_cnt >= PATIENCE:
            print(f"\n  Early stopping at epoch {epoch}")
            break

model.load_state_dict(best_weights)
print(f"\n  Best val loss: {best_val:.6f}")

# =============================================================================
# MODULE 7: EVALUATION
# =============================================================================
print("\n[Module 7] Evaluating...")

model.eval()
preds = []
with torch.no_grad():
    for i in range(0, len(X_te), BATCH_SIZE):
        out = model(X_te[i:i+BATCH_SIZE].to(device), adj_norm)
        preds.extend(out.cpu().numpy().flatten())

preds   = np.array(preds)
actuals = y_test

pred_usd   = scaler.inverse_transform(preds.reshape(-1,1)).flatten()
actual_usd = scaler.inverse_transform(actuals.reshape(-1,1)).flatten()

mse  = mean_squared_error(actual_usd, pred_usd)
rmse = np.sqrt(mse)
mae  = mean_absolute_error(actual_usd, pred_usd)
r2   = r2_score(actual_usd, pred_usd)

print(f"\n  Target Stock : {TARGET_STOCK}")
print(f"  MSE          : {mse:.4f}")
print(f"  RMSE         : {rmse:.4f}")
print(f"  MAE          : {mae:.4f}")
print(f"  R2           : {r2:.4f}")

# =============================================================================
# MODULE 8: VISUALIZATION
# =============================================================================
print("\n[Module 8] Generating plots...")

# Loss curve
plt.figure(figsize=(10, 4))
plt.plot(train_losses, label='Train Loss', color='#2196F3')
plt.plot(val_losses,   label='Val Loss',   color='#FF5722')
plt.title('Training and Validation Loss - GCN-LSTM+RSI')
plt.xlabel('Epoch')
plt.ylabel('MSE Loss')
plt.legend()
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig(BASE_PATH + 'training_loss.png', dpi=150)
plt.show()
print("  Saved: training_loss.png")

# Prediction vs Actual
plt.figure(figsize=(14, 5))
plt.plot(actual_usd, label='Actual Price',    color='#2196F3', linewidth=1.5)
plt.plot(pred_usd,   label='Predicted Price', color='#FF5722', linewidth=1.5, alpha=0.8)
plt.title(f'{TARGET_STOCK} - Actual vs Predicted Opening Price (GCN-LSTM+RSI)')
plt.xlabel('Test Days')
plt.ylabel('Price (USD)')
plt.legend()
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig(BASE_PATH + 'prediction_vs_actual.png', dpi=150)
plt.show()
print("  Saved: prediction_vs_actual.png")

# Save results
torch.save(model.state_dict(), BASE_PATH + 'gcn_lstm_model.pth')
with open(BASE_PATH + 'results.pkl', 'wb') as f:
    pickle.dump({
        'pred_usd'    : pred_usd,
        'actual_usd'  : actual_usd,
        'metrics'     : {'mse':mse,'rmse':rmse,'mae':mae,'r2':r2},
        'train_losses': train_losses,
        'val_losses'  : val_losses,
        'target_stock': TARGET_STOCK
    }, f)

print("\n" + "=" * 60)
print("  PIPELINE COMPLETE")
print(f"  Stock : {TARGET_STOCK}")
print(f"  MSE   : {mse:.4f}")
print(f"  RMSE  : {rmse:.4f}")
print(f"  MAE   : {mae:.4f}")
print(f"  R2    : {r2:.4f}")
print("=" * 60)
